{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dehkhoda",
  "version": "0.1.0",
  "identifier": "com.example.dehkhoda",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "لغت‌نامهٔ دهخدا",
        "width": 1180,
        "height": 780,
        "minWidth": 720,
        "minHeight": 480,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' ws://localhost:1420 http://localhost:1420 ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Education",
    "shortDescription": "لغت‌نامهٔ دهخدا (آفلاین)",
    "copyright": "داده: لغت‌نامهٔ دهخدا، دانشگاه تهران",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": { "resources/dehkhoda.sqlite": "dehkhoda.sqlite" },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Farsi", "English"],
        "compression": "lzma"
      }
    }
  }
}
